config BR2_PACKAGE_BALANSIR
	bool "balansir"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_PACKAGE_HOST_RUSTC
	select BR2_PACKAGE_NFTABLES
	select BR2_PACKAGE_IPROUTE2
	help
	  BalanSir is a network policy engine for Linux routers and
	  gateways: declarative policy, reconcile-driven enforcement,
	  privilege separation between an unprivileged daemon and a
	  privileged nftables executor.

	  https://github.com/Egorich-print/BalanSir

comment "balansir needs a toolchain w/ threads, C++, rustc and nftables"
	depends on !BR2_TOOLCHAIN_HAS_THREADS || !BR2_INSTALL_LIBSTDCPP || !BR2_PACKAGE_HOST_RUSTC
