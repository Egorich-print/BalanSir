# BalanSir QEMU-aarch64-virt configuration (boot/network test image).
#
# Used for automated QEMU verification of the full stack:
#   boot -> systemd -> network (virtio) -> executor -> daemon -> BALANSIR_CONFIG
#   -> first reconcile -> balansir-cli
# The RPi image (balansir_rpi3b_64_defconfig) cannot network under QEMU
# (raspi3b machine has no NIC / the bcm2711 kernel lacks virtio), so this
# build shares the same BalanSir package + systemd units and is what the
# QEMU test harness boots.
#
# Based on Buildroot's qemu_aarch64_virt_defconfig (2026.05.x).

BR2_aarch64=y
BR2_TOOLCHAIN_EXTERNAL=y
# ARM (not Bootlin): Bootlin toolchains require an x86_64 host, but the build
# VM is aarch64. The ARM aarch64 toolchain works on aarch64 hosts (matches
# how Buildroot's raspberrypi3_64 defconfig resolves on this host).
BR2_TOOLCHAIN_EXTERNAL_ARM_AARCH64=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y

# Init: systemd (uses project deploy/systemd units, ADR-030)
BR2_INIT_SYSTEMD=y

# System
BR2_SYSTEM_DHCP="eth0"
BR2_TARGET_GENERIC_HOSTNAME="balansir"
BR2_TARGET_GENERIC_ISSUE="BalanSir Network Policy Engine (QEMU virt)"
# Dev/QEMU convenience: known root password + root SSH so the test harness
# can drive balansir-cli over ssh (serial getty autologin is unreliable under
# QEMU). Dev image only.
BR2_TARGET_GENERIC_ROOT_PASSWD="balansir"
BR2_TARGET_GENERIC_GETTY_PORT="ttyAMA0"
BR2_TARGET_GENERIC_GETTY_OPTIONS="-a root"

# Rootfs overlay (configs, systemd units, tmpfiles) + post-build hooks
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_BALANSIR_PATH)/board/raspberrypi3/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_BALANSIR_PATH)/board/raspberrypi3/post-build.sh"

# Kernel (virt, virtio network/block)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/qemu/aarch64-virt/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
# BalanSir kernel fragment (TUN built-in for Tailscale).
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_BALANSIR_PATH)/board/raspberrypi3/linux.fragment"

# BalanSir + runtime deps
BR2_PACKAGE_BALANSIR=y
BR2_PACKAGE_HOST_RUSTC=y
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_IPTABLES=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_OPENSSH=y

# Operator tools
BR2_PACKAGE_TAILSCALE=y
BR2_PACKAGE_BTOP=y
BR2_PACKAGE_FASTFETCH=y

# Rootfs: ext4, no tar
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
# BR2_TARGET_ROOTFS_TAR is not set

# Reproducible
BR2_REPRODUCIBLE=y
