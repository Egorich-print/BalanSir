# BalanSir + Raspberry Pi 3B+ (AArch64) Buildroot configuration.
#
# Based on Buildroot's raspberrypi3_64_defconfig (2026.05.x) with:
#   - BalanSir package (daemon/executor/cli) + runtime deps (nft, iproute2)
#   - systemd init (uses the project's deploy/systemd units, ADR-030)
#   - read-only-ish rootfs + tmpfs /run hardening
#   - serial console for recovery, DHCP on eth0, openssh
#
# Build:  make BR2_EXTERNAL=buildroot-external balansir_rpi3b_64_defconfig
#         make

# Architecture / toolchain (aarch64). ARM external glibc toolchain: Bootlin
# toolchains require an x86_64 host, but the build VM is aarch64, so the ARM
# aarch64 toolchain (download) is used — faster than building a toolchain.
BR2_aarch64=y
BR2_ARM_FPU_VFPV4=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_ARM_AARCH64=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y

# Kernel (Raspberry Pi custom tree, bcm2711 defconfig, 3B/3B+/CM3 DTBs)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,21b410140c47ffab5668399f6f143c7d7b935c8b)/linux-21b410140c47ffab5668399f6f143c7d7b935c8b.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2710-rpi-3-b broadcom/bcm2710-rpi-3-b-plus broadcom/bcm2710-rpi-cm3"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
# BalanSir kernel fragment (TUN built-in for Tailscale).
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_BALANSIR_PATH)/board/raspberrypi3/linux.fragment"

# Firmware + boot files. Paths are relative to the Buildroot root unless
# BR2_EXTERNAL_* is used; our board files live in the external tree.
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_BOOTCODE_BIN=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_BALANSIR_PATH)/board/raspberrypi3/config_3_64bit.txt"
# Debug UART kernel cmdline (console=tty1 console=serial0,115200 loglevel=8).
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_BALANSIR_PATH)/board/raspberrypi3/cmdline.txt"

# Debug UART: serial console on ttyAMA0 @115200 for recovery + boot logs.
BR2_TARGET_GENERIC_GETTY_PORT="ttyAMA0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y

# Init: systemd (uses project deploy/systemd units, ADR-030)
BR2_INIT_SYSTEMD=y

# System
BR2_SYSTEM_DHCP="eth0"
BR2_TARGET_GENERIC_HOSTNAME="balansir"
BR2_TARGET_GENERIC_ISSUE="BalanSir Network Policy Engine"

# Rootfs overlay (configs, systemd units, tmpfiles) + post-build/image hooks
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_BALANSIR_PATH)/board/raspberrypi3/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_BALANSIR_PATH)/board/raspberrypi3/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_BALANSIR_PATH)/board/raspberrypi3/post-image.sh"

# BalanSir + runtime deps
BR2_PACKAGE_BALANSIR=y
BR2_PACKAGE_BALANSIR_OTA=y
BR2_PACKAGE_HOST_RUSTC=y
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_IPROUTE2=y
# iptables + ip6tables: tailscaled requires ip6tables for its firewall rules
# (linuxfw: clear ip6tables). Without it the daemon exits at startup.
BR2_PACKAGE_IPTABLES=y
BR2_PACKAGE_OPENSSH=y

# Operator tools
BR2_PACKAGE_TAILSCALE=y
BR2_PACKAGE_BTOP=y
BR2_PACKAGE_FASTFETCH=y

# Rootfs: ext4 on SD, no tar
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="700M"
# BR2_TARGET_ROOTFS_TAR is not set

# Host tools for the SD card image
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_HOST_MTOOLS=y

# OTA image size
BR2_TARGET_ROOTFS_EXT2_OTA_SIZE="2048M"

# Reproducible builds (ADR-029 principle; timestamps pinned)
BR2_REPRODUCIBLE=y


# Busybox: enable nc for network testing
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_BALANSIR_PATH)/board/raspberrypi3/busybox.fragment"
