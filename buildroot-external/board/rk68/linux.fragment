# BalanSir kernel config fragment for RK68 (RK3568).
#
# The RK3568 board has two onboard Ethernet controllers (eth0 fe2a0000,
# eth1 fe010000) plus USB ports for external USB Ethernet (RTL8156/AX88179)
# and Wi-Fi dongles. This fragment enables the same network feature stack as
# the RPi target so the policy engine behaves identically on both.

# USB Ethernet adapters: ASIX AX88179 + Realtek RTL8156 for USB-WAN, plus
# CDC/RNDIS for generic USB NICs.
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_CDCETHER=y

# Wi-Fi (mission §3-4): common USB 802.11 chipsets as modules.
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RT2X00=y
CONFIG_RT2800USB=y
CONFIG_RTL8187=y
CONFIG_MT7601U=m

# MPTCP (mission §5)
CONFIG_MPTCP=y
CONFIG_INET_MPTCP_DIAG=y
CONFIG_MPTCP_PM_ADDR_TYPE=y
CONFIG_MPTCP_IPV6=y

# QoS shaping (HTB/fq_codel/CAKE) + netem for the policy engine's shaping.
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_SCH_NETEM=y
CONFIG_NET_CLS_FW=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_CLS_FLOWER=y
CONFIG_NET_CLS_BASIC=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_IPT=y
CONFIG_NET_ACT_PEDIT=y

# nftables + NFQUEUE (executor mechanism + DPI-bypass engine).
CONFIG_NETFILTER=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_COUNTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_CONNTRACK_IPV6=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_IPV4=y
CONFIG_NF_NAT_IPV6=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NF_NAT_MASQUERADE_IPV4=y
CONFIG_NF_NAT_MASQUERADE_IPV6=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NFT_QUEUE=y
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=y
CONFIG_NF_QUEUE=y

# TUN (Tailscale) + netlink diag (executor).
CONFIG_TUN=y
CONFIG_NETLINK_DIAG=y

# netfilter for the balansir IPv4 forward path
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
