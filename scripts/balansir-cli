#!/bin/bash
# balansir-cli - Simple CLI wrapper for BalanSir
set -e

VERSION="0.1.0"
SOCKET_PATH="/tmp/balansir-test/daemon.sock"

show_help() {
    echo "BalanSir CLI v${VERSION}"
    echo ""
    echo "Usage: balansir-cli <command> [options]"
    echo ""
    echo "Commands:"
    echo "  status      Show daemon status"
    echo "  health      Check health"
    echo "  metrics     Show metrics"
    echo "  events      Show recent events"
    echo "  reconcile   Trigger reconciliation"
    echo "  version     Show version"
    echo "  help        Show this help"
    echo ""
}

cmd_version() {
    echo "BalanSir v${VERSION}"
}

cmd_status() {
    echo "BalanSir Status"
    echo "==============="
    if [ -S "$SOCKET_PATH" ]; then
        echo "Socket: $SOCKET_PATH (exists)"
    else
        echo "Socket: $SOCKET_PATH (not found)"
    fi
}

cmd_health() {
    curl -s http://localhost:8080/health 2>/dev/null || echo '{"status":"offline"}'
}

cmd_metrics() {
    curl -s http://localhost:8080/metrics 2>/dev/null || echo "Metrics unavailable"
}

cmd_events() {
    curl -s http://localhost:8080/events 2>/dev/null || echo '{"events":[],"count":0}'
}

cmd_reconcile() {
    curl -s -X POST http://localhost:8080/reconcile 2>/dev/null || echo '{"ok":false}'
}

case "${1:-help}" in
    status)     cmd_status ;;
    health)     cmd_health ;;
    metrics)    cmd_metrics ;;
    events)     cmd_events ;;
    reconcile)  cmd_reconcile ;;
    version)    cmd_version ;;
    help|*)     show_help ;;
esac
