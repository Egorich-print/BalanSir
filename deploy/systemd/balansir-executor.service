[Unit]
Description=BalanSir Network Policy Engine - Executor (privileged)
Documentation=https://github.com/balansir/balansir
After=network.target balansir-daemon.service
Wants=network.target
Requires=balansir-daemon.service

[Service]
Type=notify
ExecStart=/usr/local/bin/balansir-executor
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
WatchdogSec=30

# Security (needs root for netlink/nftables)
User=root
Group=root
NoNewPrivileges=no

# Capabilities
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN

# Resource limits
MemoryMax=64M
TasksMax=32

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=balansir-executor

[Install]
WantedBy=multi-user.target
